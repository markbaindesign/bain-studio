{
  "env": {
    "CLAUDE_SESSION_NAME": "BD Studio"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "Edit(**)",
      "WebSearch(*)",
      "WebFetch(*)"
