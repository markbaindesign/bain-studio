#!/usr/bin/env python3
"""Refuse a commit MESSAGE that carries client data.

pre-commit never sees the message, and the studio's own rules send reasoning
into commit messages, which are public. See _client_guard.py.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _client_guard import (compile_terms, denylist, no_registry_message, report,
                           repo_root, skipped)


def main():
    if skipped():
        return 0
    if len(sys.argv) < 2:
        return 0
    root = repo_root()
    terms = denylist(root)
    if terms is None:
        sys.stderr.write(no_registry_message())
        return 1
    patterns = compile_terms(terms)
    try:
        with open(sys.argv[1], encoding="utf-8", errors="replace") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return 0
    hits = []
    for i, text in enumerate(lines, 1):
        if text.startswith("#"):
            continue
        for term, rx in patterns:
            if rx.search(text):
                hits.append((f"commit message:{i}", term, text))
                break
    if hits:
        report(hits, "this commit message")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
