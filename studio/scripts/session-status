#!/usr/bin/env python3
"""Dense, always-on list of every Claude Code session on this machine.

Data comes from `claude agents --json`, which enumerates sessions across all
projects (the built-in `claude agents` TUI does not: it is scoped to the current
project and shows background agents only).

That command reports only the config directory it is invoked with, so one call
misses every session running under a second Claude account. Mark runs KF under
CLAUDE_CONFIG_DIR=~/.claude-kf. Every ~/.claude* directory holding a projects/
folder is therefore queried, and the account is shown when there is more than one.

Status starts from the CLI but is not trusted as-is:
    waiting  sitting on a permission prompt, needs an answer
    shell    turn is over, but a background shell keeps the CLI at "busy"
    idle     finished its turn and parked, waiting for a prompt
    working  genuinely mid-turn, needs nothing

That is also the sort order: whoever is blocked on an answer first, then the
parked sessions, then the ones working. Working sits last because a session
mid-turn is asking for nothing; an idle one may well be waiting to be picked
up. Within a group the most recently active session is at the top.

The CLI reports "busy" while any background shell the session spawned is
alive, even when the model finished its turn an hour ago and asked a
question. That is the one case this app exists to surface, and it was
sorting last. The transcript settles it: a session whose newest user or
assistant entry is an assistant one with stop_reason "end_turn" and no
outstanding tool_use has finished its turn, whatever the CLI says.

The newest entry has to be checked, not just the newest stop_reason. At the
start of a turn - prompt in, model still thinking, nothing written yet - the
previous turn's "end_turn" is still the last one in the file. Replaying one
real transcript, reading stop_reason alone called 13 of 145 turn-starts
"finished".

The transcript also carries, in the same read: context size (the last
assistant usage - input + cache_read + cache_creation + output, which matches
the figure Claude Code shows in its own footer) and the session's AI title.

Last-activity time comes from the mtime of the session transcript under
~/.claude/projects/. Transcripts are re-parsed only when that mtime moves.
No hooks, no database.

Two things the transcript cannot say are read from files the status line
already writes: the model in use and the context percentage, per session, from
~/.claude/logs/sessions/<sessionId>.json; and the quota header - the five-hour
and weekly rate limit of every account - from <config dir>/ratelimit-current.json.
Both are snapshots taken on the last status-line render, not live figures.

The `where` column gives the tmux target of each session, so it can be found by
hand: `tmux select-window -t studio:3` for `studio:3.0`.

Keys: j/k or arrows to move, r to refresh, q to quit.

`--conky` prints the same screen once as conky markup and exits, for the pinned
panel on the third monitor (~/.config/conky/studio-claude.conf). A panel is not
a window: it cannot take focus, so the dash no longer competes with the
terminal next to it for a click or a Super+Tab. The cost is that nothing
animates between refreshes - conky's ${blink} carries the waiting pulse and
the rest stand still - and that every refresh is a new process, so the
transcript cache is cold each time. A collect runs in ~0.4s, which a 5-second
panel interval absorbs.
"""

import curses
import json
import os
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

POLL_SECONDS = 4
STATUS_ORDER = {"waiting": 0, "shell": 1, "idle": 2, "working": 3}
GLYPH = {"waiting": "●", "working": "◐", "idle": "○", "shell": "◑"}

# Only the statuses that want a human pulse, so movement on screen means
# "someone is needed" and nothing else. Redrawing is decoupled from polling:
# the screen ticks at TICK_SECONDS, the CLI is still only asked every
# POLL_SECONDS. The value is how many ticks the glyph holds before it swaps
# with PULSE_OFF - waiting flips every tick, shell every third.
TICK_SECONDS = 0.5
PULSE_OFF = "◦"
PULSE = {"waiting": 1, "shell": 3}

# Working rotates rather than pulses, so work in progress is visibly alive
# without imitating a status that wants a human. The quadrants run clockwise and
# are distinct from ◐ (working at rest) and ◑ (shell), so no status can
# impersonate another mid-cycle.
SPIN = {"working": "◴◷◶◵"}
ANIMATED = set(PULSE) | set(SPIN)
DEFAULT_CONFIG = Path.home() / ".claude"

# Per-session snapshots written by ~/.claude/hooks/statusline.py on every
# render. That path is hardcoded in the hook, so sessions on a second account
# land here too, not under their own config directory.
SNAPSHOTS = DEFAULT_CONFIG / "logs" / "sessions"

# Quota percentages are only worth colouring once they are close enough to
# change what to do next: amber is "finish the task", red is "stop starting things".
QUOTA_AMBER = 70
QUOTA_RED = 90

# Row colours. Curses' eight basic colours hold no orange, and basic green is
# brighter than a status that wants nothing deserves, so the 256-colour indexes
# are used where the terminal has them and the nearest basic colour otherwise.
GREEN_256 = 71
ORANGE_256 = 208

# How much of a transcript's tail to read. Enough to hold the last assistant
# entry in all observed cases; a session whose tail is filled with
# api-request-blob lines needs the wider read, so one retry is allowed.
TAIL_BYTES = 256 * 1024
TAIL_BYTES_WIDE = 4 * 1024 * 1024

# Parsed transcripts, keyed by path -> (mtime, state). The poll is every few
# seconds and these files reach megabytes, so an unchanged one is never reread.
_CACHE = {}


def run(cmd, timeout=10, env=None):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                             env=env)
        return out.stdout if out.returncode == 0 else ""
    except (subprocess.SubprocessError, OSError):
        return ""


def config_dirs():
    """Every Claude config directory on this machine, default account first.

    A second account is a sibling of ~/.claude - ~/.claude-kf, say - selected with
    CLAUDE_CONFIG_DIR. A projects/ folder is what marks one as real rather than a
    stray backup or a file like ~/.claude.json.
    """
    found = [d for d in sorted(Path.home().glob(".claude*"))
             if d.is_dir() and (d / "projects").is_dir()]
    if DEFAULT_CONFIG in found:
        found.remove(DEFAULT_CONFIG)
        found.insert(0, DEFAULT_CONFIG)
    return found or [DEFAULT_CONFIG]


# Account label by email domain, the same two names the status line prints
# (~/.claude/hooks/statusline.py). That file is outside this repo and the app
# runs from the ops worktree, so the map is duplicated rather than imported.
ACCOUNT_LABELS = {"bain.design": "bain", "khyentsefoundation.org": "kf"}

# config dir -> label, filled only on a successful read. Claude Code rewrites
# .claude.json often, so a 4-second poll will occasionally catch it mid-write;
# without this, the label would fall back for a frame and split the tally. The
# signed-in account rarely changes while a pane runs - a logout and login in
# that config dir would do it, and then the pane needs respawning.
_ACCOUNTS = {}


def account_of(config_dir):
    """~/.claude -> 'bain', ~/.claude-kf -> 'kf'.

    Named after the signed-in account, not the directory, so the names match
    the status line. The email lives in <config dir>/.claude.json, except for
    the default account, whose file is ~/.claude.json - the same lookup the
    status line does. There is no fallback from one file to the other: reading
    the wrong one would label a KF session "bain".
    """
    if config_dir in _ACCOUNTS:
        return _ACCOUNTS[config_dir]
    account_file = (Path.home() / ".claude.json" if config_dir == DEFAULT_CONFIG
                    else config_dir / ".claude.json")
    try:
        with open(account_file) as f:
            email = json.load(f).get("oauthAccount", {}).get("emailAddress")
        domain = email.split("@")[-1]
        label = ACCOUNT_LABELS.get(domain) or domain.split(".")[0].lower()
        _ACCOUNTS[config_dir] = label
        return label
    except (OSError, ValueError, AttributeError, IndexError):
        # No readable account file: fall back to the directory suffix.
        return config_dir.name[len(".claude"):].lstrip("-.") or "default"


def sessions_for(config_dir):
    env = dict(os.environ, CLAUDE_CONFIG_DIR=str(config_dir))
    raw = run(["claude", "agents", "--json"], env=env)
    try:
        found = json.loads(raw) if raw.strip() else []
    except json.JSONDecodeError:
        return []
    for entry in found:
        entry["_account"] = account_of(config_dir)
        entry["_transcripts"] = config_dir / "projects"
    return found


def sessions():
    dirs = config_dirs()
    # One subprocess per account, in parallel: serialising them would stall the
    # redraw by ~0.3s each.
    with ThreadPoolExecutor(max_workers=max(1, len(dirs))) as pool:
        return [row for batch in pool.map(sessions_for, dirs) for row in batch]


def pane_by_pid():
    """Map every pid that owns a tmux pane to its session:window.pane target."""
    fmt = "#{session_name}:#{window_index}.#{pane_index} #{pane_pid}"
    out = run(["tmux", "list-panes", "-a", "-F", fmt])
    panes = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1].isdigit():
            panes[int(parts[1])] = parts[0]
    return panes


def ancestors(pid, limit=12):
    """Walk up /proc to the pane's own process. Claude runs as a child of the shell."""
    chain = []
    for _ in range(limit):
        try:
            stat = (Path("/proc") / str(pid) / "stat").read_text()
            ppid = int(stat.rsplit(")", 1)[1].split()[1])
        except (OSError, IndexError, ValueError):
            break
        if ppid <= 1:
            break
        chain.append(ppid)
        pid = ppid
    return chain


def locate(pid, panes):
    for candidate in [pid] + ancestors(pid):
        if candidate in panes:
            return panes[candidate]
    return None


def transcript(root, session_id):
    """The session's transcript file, or None if it has none yet."""
    for path in root.glob(f"*/{session_id}.jsonl"):
        return path
    return None


def last_activity(path, started_at_ms):
    """Transcript mtime, falling back to session start."""
    if path is not None:
        try:
            return path.stat().st_mtime
        except OSError:
            pass
    return started_at_ms / 1000


def tail_lines(path, size):
    """The last `size` bytes of a file as whole lines."""
    with open(path, "rb") as handle:
        handle.seek(0, os.SEEK_END)
        start = max(0, handle.tell() - size)
        handle.seek(start)
        data = handle.read()
    lines = data.decode("utf-8", "replace").splitlines()
    # A non-zero offset lands mid-line; that fragment is not valid JSON.
    return lines[1:] if start else lines


def scan(lines):
    """Turn state, context size and title from a slice of transcript lines.

    `finished` is the question that matters: has the model stopped and handed
    back? It is true only when the newest user-or-assistant entry is an
    assistant one that ended its turn with nothing still in flight. Every user
    entry - a prompt or a tool result - resets that, which is what keeps a turn
    in progress from reading as finished.
    """
    state = {"finished": False, "ctx": 0, "title": "", "seen_turn": False}
    for line in lines:
        if '"type"' not in line:
            continue
        try:
            entry = json.loads(line)
        except (json.JSONDecodeError, ValueError):
            continue
        kind = entry.get("type")
        if kind == "ai-title" and entry.get("aiTitle"):
            state["title"] = entry["aiTitle"]
        elif kind == "user":
            state["finished"] = False
            state["seen_turn"] = True
        elif kind == "assistant":
            message = entry.get("message", {})
            blocks = message.get("content")
            pending = isinstance(blocks, list) and any(
                b.get("type") == "tool_use" for b in blocks if isinstance(b, dict)
            )
            state["finished"] = message.get("stop_reason") == "end_turn" and not pending
            state["seen_turn"] = True
            usage = message.get("usage") or {}
            if usage:
                state["ctx"] = (
                    usage.get("input_tokens", 0)
                    + usage.get("cache_read_input_tokens", 0)
                    + usage.get("cache_creation_input_tokens", 0)
                    + usage.get("output_tokens", 0)
                )
    return state


def transcript_state(path):
    """Cached scan() of a transcript, reparsed only when its mtime moves."""
    if path is None:
        return None
    try:
        mtime = path.stat().st_mtime
    except OSError:
        return None
    cached = _CACHE.get(path)
    if cached and cached[0] == mtime:
        return cached[1]
    try:
        state = scan(tail_lines(path, TAIL_BYTES))
        if not state["seen_turn"]:
            # Nothing but blobs in the tail - look further back before giving up.
            state = scan(tail_lines(path, TAIL_BYTES_WIDE))
    except OSError:
        return None
    _CACHE[path] = (mtime, state)
    return state


def snapshot(session_id):
    """Model and context percentage for one session, or {} if not recorded yet.

    The context figure the transcript gives is a token count; the percentage
    needs the window size, which only the status line is told. These files are
    small and only the live sessions are read, so no caching is needed.
    """
    try:
        with open(SNAPSHOTS / f"{session_id}.json") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return {}
    return {"model": data.get("model") or "",
            "ctx_pct": data.get("last_context_pct") or 0}


def quota_for(config_dir):
    """One account's rate limit snapshot, or None if it has none.

    Written by the status line, so it is only as fresh as the last render on
    that account. A reset timestamp in the past means the window has rolled
    over since and the percentage belongs to the old one - the caller says
    "reset" rather than quoting it.
    """
    try:
        with open(config_dir / "ratelimit-current.json") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return None
    return {
        "account": account_of(config_dir),
        "pct": data.get("current_pct"),
        "reset_ts": data.get("reset_ts") or 0,
        "weekly_pct": data.get("weekly_pct"),
        "weekly_reset_ts": data.get("weekly_reset_ts") or 0,
    }


def quotas():
    """Every account's rate limit snapshot, default account first."""
    return [q for q in (quota_for(d) for d in config_dirs()) if q]


def short_model(name):
    """'Opus 5.5' -> 'o5.5'. Model choice is the biggest lever on quota, so it
    earns a column, but only a narrow one."""
    parts = name.split()
    if not parts:
        return ""
    version = parts[-1] if parts[-1][:1].isdigit() else ""
    return parts[0][:1].lower() + version


def tokens(count):
    """283000 -> '283k'. Zero means the transcript did not say."""
    if not count:
        return "-"
    if count < 1000:
        return str(count)
    return f"{count // 1000}k"


def ago(seconds):
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}"
    return f"{seconds // 86400}d"


def collect():
    panes = pane_by_pid()
    now = time.time()
    rows = []
    for s in sessions():
        # A crashed session can outlive its entry; trust /proc over the CLI.
        if not Path("/proc", str(s.get("pid", 0))).exists():
            continue
        path = transcript(s.get("_transcripts", DEFAULT_CONFIG / "projects"),
                          s.get("sessionId", ""))
        seen = last_activity(path, s.get("startedAt", 0))
        state = transcript_state(path)
        status = s.get("status", "?")
        # The CLI says busy while a background shell lives on. If the transcript
        # shows the turn is over, the model is not working - say so, and put it
        # in the attention group under waiting. It is its own status rather than
        # idle because a live shell may yet wake the session: it is neither
        # working nor parked.
        if status == "busy" and state and state["finished"]:
            status = "shell"
        elif status == "busy":
            # The CLI's word for it; "working" is what it means to a reader.
            status = "working"
        snap = snapshot(s.get("sessionId", ""))
        rows.append(
            {
                "status": status,
                "ctx": (state or {}).get("ctx", 0),
                "ctx_pct": snap.get("ctx_pct", 0),
                "model": snap.get("model", ""),
                "title": (state or {}).get("title", ""),
                "account": s.get("_account", "?"),
                "where": locate(s.get("pid", 0), panes) or "-",
                "project": (os.path.basename(s.get("cwd", "")) or "/")
                + (" (bg)" if s.get("kind") == "background" else ""),
                "cwd": s.get("cwd", ""),
                "name": s.get("name", ""),
                "kind": s.get("kind", ""),
                "for": now - seen,
            }
        )
    # Whoever is blocked first, then the parked ones, then the sessions that
    # need nothing; within a status, the most recently active at the top.
    rows.sort(key=lambda r: (STATUS_ORDER.get(r["status"], 9), r["for"]))
    return rows


def glyph_for(status, frame):
    """The status glyph: spun while working, pulsed when it wants a human, still
    when parked."""
    spinner = SPIN.get(status)
    if spinner:
        return spinner[frame % len(spinner)]
    hold = PULSE.get(status)
    if hold and (frame // hold) % 2:
        return PULSE_OFF
    return GLYPH.get(status, "?")


# Width of each optional column, including its leading space.
EXTRA_WIDTH = {"model": 6, "ctx": 6, "pct": 5}
# The order they are given up in: context size survives longest of the three.
EXTRA_SETS = (("model", "ctx", "pct"), ("model", "ctx"), ("ctx",), ())


def layout(width, show_account):
    """Which optional columns fit at this width, and the project column's width.

    One place decides it, so the header and the rows below it always break at
    the same place.
    """
    head_width = 25 + (6 if show_account else 0)
    room = max(0, width - 1 - head_width - 7)
    for extras in EXTRA_SETS:
        size = sum(EXTRA_WIDTH[name] for name in extras)
        if room >= 10 + size:
            return extras, min(24, room - size)
    return (), room


def header_text(width, show_account):
    """The column legend, laid out by the same rules as the rows."""
    extras, project_width = layout(width, show_account)
    account = "{:<5} ".format("acct") if show_account else ""
    text = "{} {:<8} {}{:<13} ".format(" ", "status", account, "where")
    text += "{:<{w}}".format("project"[:project_width], w=project_width)
    labels = {"model": " {:>5}".format("model"), "ctx": " {:>5}".format("ctx"),
              "pct": " {:>4}".format("ctx%")}
    text += "".join(labels[name] for name in extras)
    text += " {:>6}".format("last")
    if width >= len(text) + 24:
        text += "  " + "title"
    return text[: max(0, width - 1)]


def row_text(row, width, show_account, frame=0):
    """One row, fitted to the pane.

    The columns are given up in order of what can be done without: the title
    first, then the context percentage, then the model, then the context size,
    then the project is squeezed. Status, tmux target and the time in state
    always survive, because they are what the app is for. A fixed-width row was
    clipped by curses on the right, which cost the time column on a narrow pane
    and sliced context sizes in half. `layout` makes that choice for the header
    too.
    """
    extras, project_width = layout(width, show_account)
    account = "{:<5} ".format(row["account"][:5]) if show_account else ""
    head = "{} {:<8} {}{:<13} ".format(
        glyph_for(row["status"], frame), row["status"], account, row["where"])
    # Fixed widths even when a value is missing: every row has the same head
    # and tail, so all of them drop the same columns and the rest stay aligned.
    cells = {
        "model": " {:>5}".format(short_model(row["model"])[:5]),
        "ctx": " {:>5}".format(tokens(row["ctx"])),
        "pct": " {:>4}".format(f"{row['ctx_pct']}%" if row["ctx_pct"] else ""),
    }
    body = "{:<{w}}".format(row["project"][:project_width], w=project_width)
    body += "".join(cells[name] for name in extras)

    text = head + body + " {:>6}".format(ago(row["for"]))
    # The title is what the session is actually about, and the first thing worth
    # reading - but only where it can be shown at a useful length.
    if row["title"] and width >= len(text) + 24:
        text += "  " + row["title"][: width - len(text) - 3]
    # Below roughly 45 columns even the fixed head over-runs; truncate rather
    # than hand curses a line it would clip at a different place.
    return text[: max(0, width - 1)]


def quota_text(found):
    """The quota line, with the worst percentage on it.

    Five-hour resets are hours away, so they get a clock time; weekly resets
    are days away, so a weekday is enough. The colour is left to the caller:
    curses needs a screen before it will hand out a colour pair, and this
    needs to be readable without one.
    """
    now = time.time()
    worst = 0
    parts = []
    for q in found:
        if q["reset_ts"] and q["reset_ts"] <= now:
            # Window rolled over since the snapshot: the figure is the old one.
            five = "5h reset"
        else:
            five = f"5h {q['pct']}%"
            # No reset time rather than a wrong one: an unset timestamp would
            # format as the epoch and read as a real clock time.
            if q["reset_ts"]:
                five += " \u2192" + time.strftime("%H:%M", time.localtime(q["reset_ts"]))
            worst = max(worst, q["pct"] or 0)
        week = ""
        if q["weekly_reset_ts"] and q["weekly_reset_ts"] <= now:
            # Same as the five-hour window: a week that has rolled over since
            # the snapshot leaves last week's figure in the file. An account
            # left unused past its reset would otherwise colour the whole line.
            week = " \u00b7 wk reset"
        elif q["weekly_pct"] is not None:
            week = f" \u00b7 wk {q['weekly_pct']}%"
            if q["weekly_reset_ts"]:
                # A weekday is enough for a reset days out, but "\u2192Fri" on a
                # Friday reads as next Friday, so the last day gets a clock time.
                fmt = "%H:%M" if q["weekly_reset_ts"] - now < 86400 else "%a"
                week += " \u2192" + time.strftime(fmt, time.localtime(q["weekly_reset_ts"]))
            worst = max(worst, q["weekly_pct"])
        parts.append(f"{q['account']} {five}{week}")
    return "   ".join(parts), worst


def draw(stdscr, rows, cursor, refreshed, quota=(), frame=0):
    stdscr.erase()
    height, width = stdscr.getmaxyx()

    counts = {name: sum(1 for r in rows if r["status"] == name)
              for name in ("waiting", "shell", "idle", "working")}
    waiting = counts["waiting"]

    accounts = sorted({r["account"] for r in rows})
    # A zero shell count is dead space, like the account column.
    tally = " · ".join(f"{counts[n]} {n}"
                       for n in ("waiting", "shell", "idle", "working")
                       if n != "shell" or counts["shell"])
    head = f"{len(rows)} sessions   {tally}"
    stamp = f"{ago(time.time() - refreshed)} ago"
    if len(accounts) > 1:
        per_account = "   " + " · ".join(
            f"{a} {sum(1 for r in rows if r['account'] == a)}" for a in accounts
        )
        # Half an account tally is worse than none, so it goes only where it fits.
        if len(head) + len(per_account) + len(stamp) + 1 <= width:
            head += per_account
    stdscr.addnstr(0, 0, head.ljust(max(0, width - len(stamp) - 1)) + stamp, width - 1,
                   curses.A_BOLD | (curses.color_pair(1) if waiting
                                    else curses.color_pair(4) if counts["shell"]
                                    else 0))

    first_row = 1
    if quota and height > 2:
        text, worst = quota_text(quota)
        attr = (curses.color_pair(1) if worst >= QUOTA_RED
                else curses.color_pair(2) if worst >= QUOTA_AMBER
                else curses.A_DIM)
        stdscr.addnstr(1, 0, text.ljust(width - 1), width - 1, attr)
        first_row = 2

    # The legend sits directly over the rows it names. Dim, never reverse:
    # reverse is the cursor.
    if height > first_row + 1:
        stdscr.addnstr(first_row, 0,
                       header_text(width, len(accounts) > 1).ljust(width - 1),
                       width - 1, curses.A_DIM)
        first_row += 1

    for index, row in enumerate(rows):
        line = index + first_row
        if line >= height:
            break
        selected = cursor is not None and index == cursor
        # The account column is dead space on a single-account machine, so it
        # only appears once a second Claude config directory is in play.
        text = row_text(row, width, len(accounts) > 1, frame)
        # Working is green because it needs nothing; idle is orange because a
        # session parked with no prompt is the one that may want picking up.
        attr = curses.color_pair(
            {"waiting": 1, "shell": 4, "idle": 6, "working": 5}.get(
                row["status"], 3))
        if selected:
            attr |= curses.A_REVERSE
        stdscr.addnstr(line, 0, text.ljust(width - 1), width - 1, attr)

    if (rows and cursor is not None and cursor < len(rows)
            and height > len(rows) + first_row + 1):
        stdscr.addnstr(height - 1, 0, rows[cursor]["cwd"][: width - 1], width - 1,
                       curses.A_DIM)
    stdscr.refresh()


def main(stdscr):
    curses.curs_set(0)
    curses.use_default_colors()
    # Pair 2 stays yellow for the quota line, which has its own thresholds.
    green = GREEN_256 if curses.COLORS > GREEN_256 else curses.COLOR_GREEN
    orange = ORANGE_256 if curses.COLORS > ORANGE_256 else curses.COLOR_YELLOW
    for pair, colour in ((1, curses.COLOR_RED), (2, curses.COLOR_YELLOW), (3, -1),
                         (4, curses.COLOR_CYAN), (5, green), (6, orange)):
        try:
            curses.init_pair(pair, colour, -1)
        except curses.error:
            curses.init_pair(pair, -1, -1)
    rows = collect()
    quota = quotas()
    refreshed = time.time()
    # No cursor until the keyboard is used. Starting at row 0 made the top line
    # look picked out, which reads as a selection on a screen that is almost
    # always only read.
    cursor = None
    frame = 0

    while True:
        # Nothing moving means nothing to animate, so sit on the poll interval
        # rather than waking twice a second to redraw an unchanged screen.
        animating = any(r["status"] in ANIMATED for r in rows)
        stdscr.timeout(int((TICK_SECONDS if animating else POLL_SECONDS) * 1000))

        if cursor is not None:
            cursor = max(0, min(cursor, max(0, len(rows) - 1)))
        draw(stdscr, rows, cursor, refreshed, quota, frame)

        key = stdscr.getch()
        frame += 1
        if key in (ord("q"), 27):
            return
        if key in (ord("j"), curses.KEY_DOWN):
            cursor = 0 if cursor is None else cursor + 1
        elif key in (ord("k"), curses.KEY_UP):
            cursor = 0 if cursor is None else cursor - 1
        elif key == ord("g"):
            cursor = 0
        elif key == ord("G"):
            cursor = len(rows) - 1

        if key == ord("r") or time.time() - refreshed >= POLL_SECONDS:
            rows = collect()
            quota = quotas()
            refreshed = time.time()



# ---------------------------------------------------------------- conky mode

# Column positions in pixels, for the panel's font. Pixel gotos rather than
# character padding, because conky lays the text out proportionally even in a
# monospace font once ${goto} is in play, and a padded row drifts.
CONKY_COLUMNS = {"acct": 108, "where": 158, "project": 272,
                 "model": 446, "ctx": 502, "pct": 562, "last": 616,
                 "title": 676}

# Tokyo Night. The hues carry the same meaning as the curses screen's
# 256-colour indexes - red wants a human, cyan is a live shell, orange is
# parked and may want picking up, green needs nothing - but the panel is a
# themed surface rather than a terminal, so the values are the palette's own.
CONKY_STATUS_COLOUR = {"waiting": "f7768e", "shell": "7dcfff",
                       "idle": "ff9e64", "working": "9ece6a"}
# The quota line's own thresholds, kept off the status palette for the same
# reason the curses version keeps pair 2 to itself: recolouring the rows should
# not touch the header. Tokyo Night's yellow, then its red.
QUOTA_AMBER_HEX = "e0af68"
QUOTA_RED_HEX = "f7768e"

# The panel's own font, Roboto Mono for Powerline, has none of the status
# circles and no arrow (verified with fc-list ":charset=25d0"), and conky
# drives Xft directly: a comma-separated family list in the config is not a
# fallback chain, it picks the first family and draws a blank. So the glyph and
# the reset arrow are wrapped in one family that does have them, switched
# inline with ${font} and switched back. Override with --glyph-font; the size
# has to be restated because ${font} with no size does not inherit the panel's.
GLYPH_FONT = "DejaVu Sans Mono:size=10"


def in_glyph_font(text, font):
    """Draw this much in a font that has the character, then switch back."""
    return "${font %s}%s${font}" % (font, text)


def conky_escape(text):
    """`$` is conky's variable sigil and `$$` is how it prints a literal one.

    Session titles and project names are arbitrary text - a directory called
    `$HOME` or a title quoting a shell variable would otherwise be read as
    markup and swallow the rest of the line.
    """
    return str(text).replace("$", "$$")


def conky_row(row, show_account, glyph_font=GLYPH_FONT):
    """One session as a line of conky markup.

    Only `waiting` blinks. It is the one status that is asking for something,
    and a panel that is in the corner of the eye all day has to spend movement
    carefully: anything else that moved would train the eye to ignore all of it.
    """
    colour = CONKY_STATUS_COLOUR.get(row["status"], "9a948a")
    glyph = GLYPH.get(row["status"], "?")
    if row["status"] == "waiting":
        glyph = "${blink " + glyph + "}"
    glyph = in_glyph_font(glyph, glyph_font)
    parts = ["${color %s}%s %s" % (colour, glyph, row["status"])]
    if show_account:
        parts.append("${goto %d}${color3}%s" % (CONKY_COLUMNS["acct"],
                                                conky_escape(row["account"][:5])))
    parts.append("${goto %d}${color1}%s" % (CONKY_COLUMNS["where"],
                                            conky_escape(row["where"])))
    parts.append("${goto %d}${color}%s" % (CONKY_COLUMNS["project"],
                                           conky_escape(row["project"][:20])))
    parts.append("${goto %d}${color3}%s" % (CONKY_COLUMNS["model"],
                                            conky_escape(short_model(row["model"])[:5])))
    parts.append("${goto %d}%s" % (CONKY_COLUMNS["ctx"], tokens(row["ctx"])))
    parts.append("${goto %d}%s" % (CONKY_COLUMNS["pct"],
                                   f"{row['ctx_pct']}%" if row["ctx_pct"] else ""))
    parts.append("${goto %d}${color}%s" % (CONKY_COLUMNS["last"], ago(row["for"])))
    # The title is the most useful column and the only one that can overrun, so
    # it goes last and is cut to what the panel's width leaves for it.
    parts.append("${goto %d}${color3}%s${color}" % (
        CONKY_COLUMNS["title"], conky_escape(row["title"][:30]) if row["title"] else "-"))
    return "".join(parts)


def conky_header(rows, show_account):
    """The tally line, then the column legend.

    Same order as the curses heading, and the tally takes the colour of the
    most demanding status present, so the panel says whether anything wants a
    human before any row is read.
    """
    counts = {name: sum(1 for r in rows if r["status"] == name)
              for name in ("waiting", "shell", "idle", "working")}
    tally = " \u00b7 ".join(f"{counts[n]} {n}"
                            for n in ("waiting", "shell", "idle", "working")
                            if n != "shell" or counts["shell"])
    colour = (CONKY_STATUS_COLOUR["waiting"] if counts["waiting"]
              else CONKY_STATUS_COLOUR["shell"] if counts["shell"]
              else None)
    head = "${color1}%d sessions${color3}   %s${color}" % (len(rows), tally)
    if colour:
        head = "${color %s}%d sessions   %s${color}" % (colour, len(rows), tally)

    legend = ["${color3}  status"]
    if show_account:
        legend.append("${goto %d}acct" % CONKY_COLUMNS["acct"])
    for name, label in (("where", "where"), ("project", "project"),
                        ("model", "model"), ("ctx", "ctx"), ("pct", "ctx%"),
                        ("last", "last"), ("title", "title")):
        legend.append("${goto %d}%s" % (CONKY_COLUMNS[name], label))
    legend.append("${color}")
    return [head, "".join(legend)]


def conky_quota(found, glyph_font=GLYPH_FONT):
    """The quota line, coloured by the worst window of any account.

    `quota_text` was written to be readable without a screen, so the figure
    and the thresholds are shared with the curses version and only the colour
    is applied here.
    """
    if not found:
        return []
    text, worst = quota_text(found)
    text = conky_escape(text).replace(
        "\u2192", in_glyph_font("\u2192", glyph_font))
    colour = (QUOTA_RED_HEX if worst >= QUOTA_RED
              else QUOTA_AMBER_HEX if worst >= QUOTA_AMBER else None)
    if colour:
        return ["${color %s}%s${color}" % (colour, text)]
    return ["${color3}%s${color}" % text]


def emit_conky(glyph_font=GLYPH_FONT):
    """Print the screen once as conky markup. The panel config holds the title
    and the rule above this; everything that changes is printed here."""
    rows = collect()
    show_account = len({r["account"] for r in rows}) > 1
    lines = conky_quota(quotas(), glyph_font)
    lines += conky_header(rows, show_account)
    if rows:
        lines += [conky_row(r, show_account, glyph_font) for r in rows]
    else:
        lines.append("${color3}no sessions${color}")
    print("\n".join(lines))


if __name__ == "__main__":
    if "--conky" in sys.argv:
        font = GLYPH_FONT
        if "--glyph-font" in sys.argv:
            font = sys.argv[sys.argv.index("--glyph-font") + 1]
        emit_conky(font)
    else:
        try:
            curses.wrapper(main)
        except KeyboardInterrupt:
            pass
